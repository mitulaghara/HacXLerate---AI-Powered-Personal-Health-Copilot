{
  "name": "gramin-arogya-rural-health",
  "version": "1.0.0",
  "description": "GraminArogya: AI-Powered Personal Health Copilot & Rural Health Intelligence Platform for HacXLerate 2026",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "start": "cd backend && npm start",
    "build": "cd backend && npm install",
    "postinstall": "cd backend && npm install",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.2",
    "nanoid": "^3.3.7",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}